# Copy to terraform.prod.tfvars locally (gitignored) or store the same body in GitHub secret TERRAFORM_PROD_TFVARS.
# Replace every placeholder below with real production values before apply.

# Production reliability profile
enable_application_insights  = true
log_analytics_retention_days = 30

# Security hardening (no domain-resource changes)
key_vault_soft_delete_retention_days   = 90
key_vault_purge_protection_enabled     = true
backend_allow_insecure_connections     = false
ai_allow_insecure_connections          = false
sql_allow_azure_services_firewall_rule = true
sql_allowed_ip_ranges = [
	{
		name     = "admin-egress"
		start_ip = "203.0.113.10" # RFC 5737 TEST-NET-3 placeholder — use your current public IP / range
		end_ip   = "203.0.113.10"
	}
]
storage_blob_delete_retention_days      = 30
storage_container_delete_retention_days = 7
storage_blob_versioning_enabled         = true
storage_change_feed_enabled             = true

backend_container_cpu    = 0.5
backend_container_memory = "1Gi"
backend_min_replicas     = 1
backend_max_replicas     = 3

ai_container_cpu    = 0.5
ai_container_memory = "1Gi"
ai_min_replicas     = 0
ai_max_replicas     = 2

sql_max_size_gb = 5

monthly_budget_amount = 75
enable_budget_alert   = true
budget_start_date     = "2026-04-01T00:00:00Z"
budget_alert_emails   = ["ops@example.com"]

# Prefer TF_VAR_budget_alert_emails from CI for rotation without editing this file.
# export TF_VAR_budget_alert_emails='["team@example.com"]'

# SQL admin password: never commit. Use TF_VAR_sql_admin_password (local) or GitHub secret TF_VAR_SQL_ADMIN_PASSWORD.

# Backend runtime (rotate SMTP via secrets, not the committed example)
smtp_host       = "smtp.example.com"
smtp_port       = 587
smtp_enable_ssl = true
smtp_username   = "notifications@example.com"
smtp_from_email = "notifications@example.com"
smtp_from_name  = "Crime Portal Notifications"

azure_openai_enabled  = false
azure_openai_endpoint = "https://your-resource.openai.azure.com/"

insightface_enabled            = true
insightface_base_url           = "https://your-ai-app.internal.your-region.azurecontainerapps.io"
insightface_timeout_seconds    = 30
insightface_min_similarity     = 0.85
insightface_max_search_results = 3

# Comma-separated origins for backend CORS
frontend_url               = "https://www.example.com,https://example.com"
frontend_custom_domain     = "example.com"
frontend_www_custom_domain = "www.example.com"

jwt_access_token_expiration_minutes = 60
jwt_refresh_token_expiration_days   = 7

# Provide via environment / CI secrets (never commit):
# - TF_VAR_smtp_password
# - TF_VAR_azure_openai_api_key
# - TF_VAR_sql_admin_password
