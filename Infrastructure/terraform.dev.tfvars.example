# Copy to terraform.dev.tfvars for local non-prod plans (gitignored), or rely on CI which copies this file for PR plans.
# Replace placeholders with your non-production values.

# Non-production cost-conscious profile
enable_application_insights  = false
log_analytics_retention_days = 7

backend_container_cpu    = 0.5
backend_container_memory = "1Gi"
backend_min_replicas     = 0
backend_max_replicas     = 1

ai_container_cpu    = 1.0
ai_container_memory = "2Gi"
ai_min_replicas     = 0
ai_max_replicas     = 1

sql_max_size_gb = 2

monthly_budget_amount = 25
enable_budget_alert   = true
budget_start_date     = "2026-01-01T00:00:00Z"
budget_alert_emails   = ["dev-plan@example.com"]

# Optional: override via TF_VAR_budget_alert_emails
