# Use Vite dev proxy (/api -> http://localhost:5128) so HttpOnly auth cookies work locally
VITE_API_BASE_URL=/api
# Do not set in production — bearer fallback is for local dev only (API ExposeTokensInResponse in Development)
# VITE_ALLOW_BEARER_AUTH=true
VITE_APP_ENV=development
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_TEST_ROUTES=false
VITE_APP_NAME=Central Co-op Interactive Portal
VITE_APP_VERSION=1.0.0
VITE_IDLE_TIMEOUT_MINUTES=60