    "pre-build": "node scripts/pre-build-check.js",
    "post-build": "node scripts/post-build-check.js",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
