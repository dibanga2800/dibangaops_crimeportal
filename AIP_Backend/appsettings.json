{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AIPBackend.Controllers.AuthController": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "DefaultDbConnection": "",
    "StorageAccount": ""
  },
  "Jwt": {
    "Key": "REPLACE_WITH_JWT_SIGNING_KEY_AT_LEAST_32_CHARACTERS_USE_KEY_VAULT_IN_PROD",
    "PreviousKeys": [],
    "Issuer": "AIPBackend",
    "Audience": "AIPFrontend",
    "AccessTokenExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "Auth": {
    "Cookies": {
      "AccessTokenCookieName": "aip_access",
      "RefreshTokenCookieName": "aip_refresh",
      "CsrfCookieName": "aip_csrf",
      "Domain": null,
      "SameSite": "Lax",
      "Secure": true,
      "ExposeTokensInResponse": false,
      "RefreshTokenPath": "/api/Auth"
    }
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "REPLACE_ME",
    "Password": "REPLACE_WITH_SMTP_PASSWORD_FROM_KEY_VAULT",
    "FromEmail": "notifications@example.com",
    "FromName": "Crime Portal Notifications"
  },
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": "REPLACE_WITH_AZURE_OPENAI_KEY_FROM_KEY_VAULT",
    "Deployment": "crime-portal-ai",
    "Enabled": false
  },
  "InsightFace": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30,
    "MinSimilarity": 0.85,
    "MaxSearchResults": 3
  },
  "IncidentImageStorage": {
    "Mode": "database",
    "ContainerName": "images",
    "BlobPathPrefix": "verification"
  },
  "Security": {
    "EnableSwaggerInProduction": false,
    "EnableSwaggerUiInProduction": false,
    "AllowWildcardVercelOrigins": false,
    "EnableRateLimiting": true,
    "GlobalRateLimitPermitLimit": 120,
    "GlobalRateLimitWindowSeconds": 60,
    "EnableUploadsStaticFilesInProduction": false,
    "RequireAuthForUploads": true,
    "RunMigrationsOnStartup": true,
    "RunPageAccessInitializationOnStartup": true,
    "MaxMultipartBodyLengthBytes": 10485760
  },
  "FileStorage": {
    "MaxFileSizeBytes": 10485760,
    "BlockedExtensions": [".exe", ".dll", ".bat", ".cmd", ".com", ".msi", ".ps1", ".sh", ".js", ".jar", ".scr"]
  }
}
